\frametitle{Permutation in String: Fixed Window}
\textbf{Problem:} Does $s_2$ contain a permutation of $s_1$?

    \begin{center}
    \begin{tikzpicture}
        % Background Array s2: e i d b a c
        \foreach \x/\val in {0/e, 1/i, 2/d, 3/b, 4/a, 5/c}
            \node[draw, minimum size=0.7cm] (s\x) at (\x,0) {\val};

        % Moving Window
        \draw<1>[blue, ultra thick] (-0.4,-0.4) rectangle (1.4,0.4);
        \node<1>[blue] at (0.5, -0.8) {Window 1};

        \draw<2>[blue, ultra thick] (0.6,-0.4) rectangle (2.4,0.4);
        \node<2>[blue] at (1.5, -0.8) {Window 2};

        \draw<3>[green, ultra thick] (2.6,-0.4) rectangle (4.4,0.4);
        \node<3>[green] at (3.5, -0.8) {Permutation Found!};
    \end{tikzpicture}
    \end{center}

    \begin{block}{HashMap Slide Logic}<4->
\begin{lstlisting}[language=Kotlin]
// 1. Add right character
s2Map[s2[right]] = s2Map.getOrDefault(s2[right], 0) + 1
// 2. Remove left character
if (s2Map[s2[left]] == 1) s2Map.remove(s2[left])
else s2Map[s2[left]] = s2Map[s2[left]]!! - 1
// 3. Compare Maps
if (s1Map == s2Map) return true
\end{lstlisting}
    \end{block}
