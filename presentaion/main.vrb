\frametitle{Problem: Postfix Expression Evaluation}
\textbf{Scenario:}
  Evaluate the value of an arithmetic expression in Reverse Polish Notation (RPN), supporting standard operators.

  \vspace{0.3cm}
  \textbf{Examples:}
  \begin{itemize}
    \item \textbf{Input:} \texttt{['4','13','5','/','+']} $\rightarrow$ \textbf{Output:} \texttt{6}
  \end{itemize}
